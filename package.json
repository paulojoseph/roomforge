{
  "name": "roomforge",
  "version": "0.4.2",
  "description": "Floor plan editor for the browser: draw walls in 2D, see them in 3D, get room areas, export glTF.",
  "private": true,
  "license": "MIT",
  "author": "Paulo Marques",
  "repository": {
    "type": "git",
    "url": "https://github.com/paulojoseph/roomforge"
  },
  "bugs": {
    "url": "https://github.com/paulojoseph/roomforge/issues"
  },
  "homepage": "https://github.com/paulojoseph/roomforge",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "NEXT_TELEMETRY_DISABLED=1 next dev",
    "build": "NEXT_TELEMETRY_DISABLED=1 next build",
    "start": "NEXT_TELEMETRY_DISABLED=1 next start",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test bin scripts",
    "fixtures": "node scripts/generate-fixtures.mjs",
    "fixtures:check": "node scripts/generate-fixtures.mjs --check",
    "sync:examples": "node scripts/sync-examples.mjs",
    "build:cli": "esbuild bin/roomforge.mjs --bundle --platform=node --format=esm --outfile=dist/roomforge.mjs"
  },
  "dependencies": {
    "@react-three/drei": "10.7.8",
    "@react-three/fiber": "9.7.0",
    "nanoid": "5.1.16",
    "next": "15.5.25",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "0.185.1",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.6",
    "@types/node": "22.20.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@types/three": "0.185.4",
    "autoprefixer": "10.5.4",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "eslint-config-next": "15.5.25",
    "postcss": "8.5.26",
    "tailwindcss": "3.4.19",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
